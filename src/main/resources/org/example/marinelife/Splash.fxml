<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="splashRoot"
           stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/23"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.marinelife.SplashController">

    <children>
        <ImageView fx:id="backgroundImage"
                   mouseTransparent="true"
                   preserveRatio="false">
            <image>
                <Image url="@WelcomePage.jpg"/>
            </image>
        </ImageView>

        <StackPane styleClass="splash-overlay"
                   mouseTransparent="true"/>

        <VBox alignment="CENTER"
              spacing="22"
              maxWidth="650"
              styleClass="splash-content">

            <Label text="✦  DISCOVER THE OCEAN  ✦"
                   styleClass="splash-eyebrow"/>

            <Label text="MARINE LIFE"
                   styleClass="splash-heading"/>

            <Label text="A world of extraordinary creatures and underwater plants is waiting for you."
                   wrapText="true"
                   maxWidth="560"
                   styleClass="splash-description"/>

            <Button text="DIVE IN  →"
                    onAction="#continueToLogin"
                    styleClass="dive-button"/>
        </VBox>
    </children>
</StackPane>